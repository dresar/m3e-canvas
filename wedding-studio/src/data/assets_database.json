  "animations": [
    {
      "id": "anim-fade-up-spring",
      "name": "Fade Up Spring",
      "engine": "animejs",
      "props": { "translateY": [30, 0], "opacity": [0, 1], "easing": "easeOutElastic(1, .8)", "duration": 1200 }
    },
    {
      "id": "anim-floral-unfold",
      "name": "Floral Unfold & Scale",
      "engine": "animejs",
      "props": { "scale": [0.8, 1], "rotate": [-15, 0], "opacity": [0, 1], "easing": "easeOutCubic", "duration": 1400 }
    },
    {
      "id": "anim-wax-seal-pop",
      "name": "Wax Seal Unseal Click",
      "engine": "animejs",
      "props": { "scale": [1, 1.3, 0], "opacity": [1, 1, 0], "rotate": [0, 20], "duration": 600, "easing": "easeInOutBack" }
    },
    {
      "id": "anim-turntable-spin",
      "name": "Turntable Disc Continuous Spin",
      "engine": "css",
      "keyframes": "@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }"
    }
  ]
